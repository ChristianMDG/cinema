{
  "info": {
    "name": "Cinema - Christian (Auth & Reservations)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "clientToken", "value": "" },
    { "key": "otherClientToken", "value": "" },
    { "key": "employeeToken", "value": "" },
    { "key": "managerToken", "value": "" },
    { "key": "reservationId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Register CLIENT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Client\",\n  \"lastName\": \"Test\",\n  \"birthdate\": \"2000-01-01\",\n  \"email\": \"client1@test.mg\",\n  \"password\": \"password123\",\n  \"phone\": \"0340000001\",\n  \"role\": \"CLIENT\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response has token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.token).to.exist;",
                  "    pm.collectionVariables.set('clientToken', json.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register second CLIENT (other)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Other\",\n  \"lastName\": \"Client\",\n  \"birthdate\": \"1999-05-05\",\n  \"email\": \"client2@test.mg\",\n  \"password\": \"password123\",\n  \"phone\": \"0340000002\",\n  \"role\": \"CLIENT\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('otherClientToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register EMPLOYEE",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Employee\",\n  \"lastName\": \"Test\",\n  \"birthdate\": \"1995-03-10\",\n  \"email\": \"employee1@test.mg\",\n  \"password\": \"password123\",\n  \"phone\": \"0340000003\",\n  \"role\": \"EMPLOYEE\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('employeeToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register MANAGER",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Manager\",\n  \"lastName\": \"Test\",\n  \"birthdate\": \"1990-07-15\",\n  \"email\": \"manager1@test.mg\",\n  \"password\": \"password123\",\n  \"phone\": \"0340000004\",\n  \"role\": \"MANAGER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('managerToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login CLIENT (valid credentials)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"client1@test.mg\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Role is CLIENT', function () {",
                  "    pm.expect(pm.response.json().role).to.eql('CLIENT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"client1@test.mg\",\n  \"password\": \"wrongpassword\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - duplicate email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Client\",\n  \"lastName\": \"Duplicate\",\n  \"birthdate\": \"2000-01-01\",\n  \"email\": \"client1@test.mg\",\n  \"password\": \"password123\",\n  \"phone\": \"0340000005\",\n  \"role\": \"CLIENT\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 (conflict)', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Reservations",
      "item": [
        {
          "name": "POST /reservations - create as CLIENT",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "url": "{{baseUrl}}/reservations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Client\",\n  \"lastName\": \"Test\",\n  \"birthdate\": \"2000-01-01\",\n  \"email\": \"client1@test.mg\",\n  \"password\": \"password123\",\n  \"phone\": \"0340000001\",\n  \"role\": \"CLIENT\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Save reservation id', function () {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('reservationId', json.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /reservations - as CLIENT (should be 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/reservations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 for CLIENT', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /reservations - as EMPLOYEE (should be 200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
            "url": "{{baseUrl}}/reservations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 for EMPLOYEE', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /reservations - as MANAGER (should be 200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/reservations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 for MANAGER', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /reservations/:id - owner CLIENT (should be 200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/reservations/{{reservationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 for owner CLIENT', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /reservations/:id - other CLIENT (should be 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{otherClientToken}}" }],
            "url": "{{baseUrl}}/reservations/{{reservationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 for non-owner CLIENT', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /reservations/:id - as MANAGER (should be 200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/reservations/{{reservationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 for MANAGER', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /reservations/:id - as EMPLOYEE (should be 200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
            "url": "{{baseUrl}}/reservations/{{reservationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 for EMPLOYEE', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /reservations/:id - as CLIENT (should be 403)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "url": "{{baseUrl}}/reservations/{{reservationId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"birthdate\": \"2000-01-01\",\n  \"email\": \"client1@test.mg\",\n  \"password\": \"password123\",\n  \"phone\": \"0340000001\",\n  \"role\": \"CLIENT\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 for CLIENT', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /reservations/:id - as EMPLOYEE (should be 200)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ],
            "url": "{{baseUrl}}/reservations/{{reservationId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"birthdate\": \"2000-01-01\",\n  \"email\": \"client1@test.mg\",\n  \"password\": \"password123\",\n  \"phone\": \"0340000001\",\n  \"role\": \"CLIENT\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 for EMPLOYEE', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /reservations/:id - as MANAGER (should be 200)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": "{{baseUrl}}/reservations/{{reservationId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"birthdate\": \"2000-01-01\",\n  \"email\": \"client1@test.mg\",\n  \"password\": \"password123\",\n  \"phone\": \"0340000001\",\n  \"role\": \"CLIENT\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 for MANAGER', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /reservations/:id - no token (should be 401/403)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reservations/{{reservationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 or 403 without token', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}